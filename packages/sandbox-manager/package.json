    "@deepseek-ai/cordis": "^4.0.1",
    "@dsh-cloud/execution-agent": "workspace:*",
    "@dsh-cloud/execution-client": "workspace:*",
    "@dsh-cloud/fs-remote": "workspace:*",
    "@dsh-cloud/run-context": "workspace:*",
    "@dsh-cloud/subprocess-remote": "workspace:*",
    "@types/pg": "^8.15.5"
  },
  "scripts": {
    "start": "node lib/main.js"
