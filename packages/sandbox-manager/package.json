{
  "name": "@dsh-cloud/sandbox-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "types": "lib/main.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cube": {
      "types": "./lib/cube-provider.d.ts",
      "default": "./lib/cube-provider.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@dsh-cloud/execution-protocol": "workspace:*",
    "pg": "^8.16.3",
    "undici": "^7.22.0"
