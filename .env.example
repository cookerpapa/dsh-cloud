DSH_CLOUD_DATABASE_URL=postgresql://dsh_cloud:dsh_cloud@127.0.0.1:5438/dsh_cloud
DSH_CLOUD_NAMESPACE=local
DSH_CLOUD_HOST=127.0.0.1
DSH_CLOUD_PORT=3080
DSH_CLOUD_WORKER_ID=worker-local-1
DSH_CLOUD_WORKER_SLOTS=4
DSH_CLOUD_WORKER_DRAIN_TIMEOUT_MS=540000
DSH_CLOUD_RUN_LEASE_SECONDS=20
DSH_CLOUD_WORKER_METRICS_PORT=9090
DSH_CLOUD_WORKER_URL=http://127.0.0.1:3080
DSH_CLOUD_GATEWAY_HOST=0.0.0.0
DSH_CLOUD_GATEWAY_PORT=8080
DSH_CLOUD_SECURE_COOKIES=0
# DSH_CLOUD_PUBLIC_ORIGIN=https://dsh.example.com
DSH_CLOUD_SANDBOX_MANAGER_URL=http://127.0.0.1:3090
DSH_CLOUD_SANDBOX_MANAGER_TOKEN=replace-with-at-least-32-random-characters
# 32 random bytes encoded as base64; only Sandbox Manager reads this key.
DSH_CLOUD_SANDBOX_ENCRYPTION_KEY=replace-with-base64
DSH_CLOUD_SANDBOX_IDLE_TTL_MS=1800000
DSH_CLOUD_CUBE_API_URL=http://127.0.0.1:3000
DSH_CLOUD_CUBE_API_KEY=replace-with-cube-api-key
DSH_CLOUD_CUBE_TEMPLATE_ID=replace-with-template-id
DSH_CLOUD_CUBE_PROXY_NODE_IP=127.0.0.1
DSH_CLOUD_CUBE_PROXY_PORT=8080
DSH_CLOUD_CUBE_PROXY_SCHEME=http
DSH_CLOUD_CUBE_DOMAIN=cube.local
# Sandboxes may connect only to this trusted egress proxy address.
DSH_CLOUD_CUBE_EGRESS_PROXY_IP=127.0.0.1
DSH_CLOUD_CUBE_VOLUME_DRIVER=dsh-cloud-posix
# DEEPSEEK_API_KEY=replace-me
