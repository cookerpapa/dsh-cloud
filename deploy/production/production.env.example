# Copy to production.env and keep mode 0600. install.sh generates the first
# four secret values when it creates the file. The generated Cube API key must
# also populate the dsh-cloud-cube-api-credential Kubernetes Secret.
POSTGRES_PASSWORD=
DSH_CLOUD_TOOL_BROKER_TOKEN=
DSH_CLOUD_SANDBOX_ENCRYPTION_KEY=
DSH_CLOUD_CUBE_API_KEY=

DSH_CLOUD_NAMESPACE=production
DSH_CLOUD_HTTP_BIND=127.0.0.1
DSH_CLOUD_HTTP_PORT=8080
DSH_CLOUD_GATEWAY_DB_POOL=20
DSH_CLOUD_AGENT_PRESETS=standard,code
DSH_CLOUD_SECURE_COOKIES=0
DSH_CLOUD_PUBLIC_ORIGIN=
DSH_CLOUD_EVENT_PROJECTION_TIMEOUT_MS=90000
DSH_CLOUD_WORKER_SLOTS=4
DSH_CLOUD_WORKER_DRAIN_TIMEOUT_MS=540000
DSH_CLOUD_RUN_LEASE_SECONDS=20
DSH_CLOUD_SANDBOX_IDLE_TTL_MS=1800000
DSH_CLOUD_KAFKA_SESSION_TOPIC=dsh-cloud-session-events-v2
DSH_CLOUD_KAFKA_PARTITIONS=12
DSH_CLOUD_KAFKA_REPLICATION_FACTOR=1
DSH_CLOUD_KAFKA_EVENT_RETENTION_MS=2592000000
DSH_CLOUD_LIVE_EVENT_RETENTION_SECONDS=86400

DEEPSEEK_API_KEY=
DSH_CLOUD_CUBE_API_URL=
DSH_CLOUD_CUBE_CONTROL_NETWORK=
DSH_CLOUD_CUBE_TEMPLATE_ID=
DSH_CLOUD_CUBE_PROXY_NODE_IP=
DSH_CLOUD_CUBE_PROXY_PORT=80
DSH_CLOUD_CUBE_PROXY_SCHEME=http
DSH_CLOUD_CUBE_DOMAIN=cube.local
DSH_CLOUD_CUBE_EGRESS_PROXY_IP=
DSH_CLOUD_CUBE_VOLUME_DRIVER=dsh-cloud-posix
