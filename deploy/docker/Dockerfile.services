# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
WORKDIR /src
RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://deb.debian.org/debian-security|http://mirrors.tuna.tsinghua.edu.cn/debian-security|g' /etc/apt/sources.list.d/debian.sources \
 && apt-get update && apt-get install -y --no-install-recommends g++ make python3 \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable \
 && corepack prepare pnpm@11.7.0 --activate
COPY . .
RUN --mount=type=cache,id=dsh-cloud-pnpm-store,target=/pnpm/store \
 pnpm install --frozen-lockfile && pnpm build

FROM build AS worker-package
RUN --mount=type=cache,id=dsh-cloud-pnpm-store,target=/pnpm/store \
 pnpm --filter @dsh-cloud/web deploy --prod --legacy /out/worker

FROM build AS gateway-package
RUN --mount=type=cache,id=dsh-cloud-pnpm-store,target=/pnpm/store \
 pnpm --filter @dsh-cloud/gateway deploy --prod --legacy /out/gateway

FROM build AS tool-broker-package
RUN --mount=type=cache,id=dsh-cloud-pnpm-store,target=/pnpm/store \
 pnpm --filter @dsh-cloud/tool-broker deploy --prod --legacy /out/tool-broker

FROM build AS cube-api-authorizer-package
RUN --mount=type=cache,id=dsh-cloud-pnpm-store,target=/pnpm/store \
 pnpm --filter @dsh-cloud/cube-api-authorizer deploy --prod --legacy /out/cube-api-authorizer

FROM node:24-bookworm-slim AS worker
ENV NODE_ENV=production
WORKDIR /app
RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://deb.debian.org/debian-security|http://mirrors.tuna.tsinghua.edu.cn/debian-security|g' /etc/apt/sources.list.d/debian.sources \
 && apt-get update && apt-get install -y --no-install-recommends bash ca-certificates git openssh-client python3 tini \
 && rm -rf /var/lib/apt/lists/* && mkdir -p /workspace /var/lib/dsh \
 && chown node:node /app /workspace /var/lib/dsh
COPY --from=worker-package --chown=node:node /out/worker/ /app/
USER node
EXPOSE 3080
EXPOSE 9090
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["node","lib/main.js"]

FROM node:24-bookworm-slim AS cube-api-authorizer
ENV NODE_ENV=production
WORKDIR /app
COPY --from=cube-api-authorizer-package --chown=node:node /out/cube-api-authorizer/ /app/
USER node
EXPOSE 8080
CMD ["node","lib/main.js"]

FROM node:24-bookworm-slim AS gateway
ENV NODE_ENV=production
WORKDIR /app
RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://deb.debian.org/debian-security|http://mirrors.tuna.tsinghua.edu.cn/debian-security|g' /etc/apt/sources.list.d/debian.sources \
 && apt-get update && apt-get install -y --no-install-recommends ca-certificates tini && rm -rf /var/lib/apt/lists/*
COPY --from=gateway-package --chown=node:node /out/gateway/ /app/
USER node
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["node","lib/main.js"]

FROM node:24-bookworm-slim AS tool-broker
ENV NODE_ENV=production
WORKDIR /app
RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://deb.debian.org/debian-security|http://mirrors.tuna.tsinghua.edu.cn/debian-security|g' /etc/apt/sources.list.d/debian.sources \
 && apt-get update && apt-get install -y --no-install-recommends ca-certificates tini && rm -rf /var/lib/apt/lists/*
COPY --from=tool-broker-package --chown=node:node /out/tool-broker/ /app/
USER node
EXPOSE 3090
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["node","lib/main.js"]
